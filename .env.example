# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
# Used when a request doesn't specify ai_model: "flash" or "flash-lite"
GEMINI_DEFAULT_MODEL=flash
MAX_IMAGE_DIMENSION=768

# ── Rendering (see docs/ARCHITECTURE.md) ──────────────────────────────
# Palette size for the whole skin; slots 0-6 are the semantic roles.
PALETTE_SIZE=16
# Downscaling method per content type: box | dpid | dominant
# The face wants feature survival, clothing wants clean flat blocks.
FACE_METHOD=dpid
MATERIAL_METHOD=dominant
# Pre-sharpen amount (linear light) applied before the ~16x reduction.
PRESHARPEN=0.45
# DPID detail weighting; higher keeps more, at the cost of average accuracy.
DPID_LAMBDA=1.4
# Vision models report a face box (eyebrows to chin), not a head box. Grow the
# top edge by this fraction of the box height to recover the hair, and the
# sides by this fraction of its width. 0 disables.
HEAD_TOP_MARGIN=0.45
HEAD_SIDE_MARGIN=0.12
