# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
# Used when a request doesn't specify ai_model: "flash" or "flash-lite"
GEMINI_DEFAULT_MODEL=flash
MAX_IMAGE_DIMENSION=768

# ── Rendering (see docs/ARCHITECTURE.md) ──────────────────────────────
# Palette size for the whole skin; slots 0-6 are the semantic roles.
PALETTE_SIZE=16
# Downscaling method per content type: box | dpid | dominant
# The face wants feature survival, clothing wants clean flat blocks.
FACE_METHOD=dpid
MATERIAL_METHOD=dominant
# Pre-sharpen amount (linear light) applied before the ~16x reduction.
PRESHARPEN=0.45
# DPID detail weighting; higher keeps more, at the cost of average accuracy.
DPID_LAMBDA=1.4
# Vision models report a face box (eyebrows to chin), not a head box. Grow the
# top edge by this fraction of the box height to recover the hair, and the
# sides by this fraction of its width. 0 disables.
HEAD_TOP_MARGIN=0.45
HEAD_SIDE_MARGIN=0.12
# How the head front is produced. "template" draws it from a face template
# coloured by the photo — the only thing that is readable at 8x8. "photo"
# resamples the photo directly (kept for A/B comparison).
HEAD_MODE=template
# How much of the photo's within-region lightness variation survives. 0 gives
# flat vector-art regions; 1 lets the photo push the template around.
FACE_MODULATION=0.6

# ── Albedo: a photo is material × light; a skin texture wants material ──────
# Flatten each region's illumination gradient before quantizing. 1.0 removes
# it outright, which is also what frees palette slots for real materials.
FLATTEN_SHADING=1.0
# How much OKLab lightness counts when clustering the palette. Below 1, the
# same garment lit and shaded lands in one slot. Only helps materials with
# chroma; a near-white garment relies on FLATTEN_SHADING instead.
PALETTE_LIGHTNESS_WEIGHT=0.7
# Which percentile of a cluster's lightness becomes its color — the material
# as it looks lit, rather than an average dragged dark by its own shadow.
ALBEDO_PERCENTILE=80
# Orientation shading baked into procedurally generated faces. 0 keeps the
# texture flat and lets the game do the lighting.
BAKE_ORIENTATION_SHADING=0.0
